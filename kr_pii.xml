<?xml version="1.0" encoding="UTF-8"?>
<Grammars>
  <Dictionary name="kr_pii" case="off">

    <!-- Drivers_License rule: keyword condition, whole word, >=1 -->
    <EntrySet name="dl_terms">
      <Entry headword="자동차운전면허증" />
      <Entry headword="Driver's License">
        <Synonym>Driver’s License</Synonym>
      </Entry>
    </EntrySet>

    <!-- Korean_Passport rule: passport keyword condition, >=1 -->
    <EntrySet name="passport_terms">
      <Entry headword="passport" />
      <Entry headword="Korean Passport" />
      <Entry headword="Korean Passports" />
      <Entry headword="passport book" />
      <Entry headword="한국어 여권" />
      <Entry headword="여권" />
      <Entry headword="여권 번호" />
    </EntrySet>

    <!-- Korean_Passport rule: standalone "Korea" keyword condition -->
    <EntrySet name="korea">
      <Entry headword="Korea" />
    </EntrySet>

    <!-- Korean_Credit_Cards rule: Korea/Korean keyword condition -->
    <EntrySet name="korea_kr">
      <Entry headword="Korea" />
      <Entry headword="Korean" />
    </EntrySet>

    <!-- Korean_Bank_Account_Numbers rule: wide Korea keyword condition -->
    <EntrySet name="korea_wide">
      <Entry headword="Korea" />
      <Entry headword="Korean" />
      <Entry headword="Seoul" />
      <Entry headword="한국" />
